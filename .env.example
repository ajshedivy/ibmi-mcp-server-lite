# IBM i / Db2 for i connection (consumed by ${VAR} interpolation in tools YAML)
# NOTE: DB2i_HOST must match a name in the Mapepire server certificate's SAN —
# mapepire-java verifies the TLS hostname even with ignore-unauthorized: true.
# See docs/running-on-ibmi.md#tls-hostname-verification
#
# Optional: chmod 0600 .env  (required for any populated .env when MCP_SERVER_ENV=production)
# See docs/running-on-ibmi.md#secret-file-permissions
DB2i_HOST=your-ibmi-host.example.com
DB2i_USER=your-user
DB2i_PASS=your-password
DB2i_PORT=8076

# Accept self-signed certificates from the Mapepire server
DB2i_IGNORE_UNAUTHORIZED=true

# Hot-reload tools YAML on file change (default: true). Set to false or use --no-reload to disable.
YAML_AUTO_RELOAD=true

# Mapepire connection pool timeouts (Node reference defaults). Applied to YAML sources
# when mcp-pool-idle-timeout-ms / mcp-pool-query-timeout-ms are omitted. YAML wins when set.
# Set either to 0 to disable that behavior.
# Idle: close unused pools after inactivity; next tools/call recreates lazily. Default: 300000 (5 min)
MCP_POOL_IDLE_TIMEOUT_MS=300000
# Query: fail Mapepire execute/fetch after this many ms and evict the pool. Default: 30000 (30s)
MCP_POOL_QUERY_TIMEOUT_MS=30000

# Mapepire JDBC connection options (optional)
# Format: semicolon-separated key=value pairs (matches DB2 JDBC URL syntax)
# - Keys with spaces are allowed (e.g., "date format")
# - The "libraries" value is comma-separated (the only array-valued option)
# - All other values are forwarded as strings to the JDBC driver
# - Overrides any jdbc-options set in YAML sources
# Example: DB2i_JDBC_OPTIONS='naming=system;date format=iso;libraries=MYLIB,DEVDATA'
# DB2i_JDBC_OPTIONS=

# Tools YAML path (file, directory, or glob). CLI --tools wins when both are set.
# Directory load (tools/) registers all vendored packs; subset with --toolsets / SELECTED_TOOLSETS.
# TOOLS_YAML_PATH=tools

# Multi-file YAML merge (--tools directory or glob). Only literal "true" enables a flag.
# Directory loads need YAML_ALLOW_DUPLICATE_SOURCES=true because every pack defines ibmi-system.
YAML_MERGE_ARRAYS=true
YAML_ALLOW_DUPLICATE_TOOLS=false
YAML_ALLOW_DUPLICATE_SOURCES=true
YAML_VALIDATE_MERGED=true


# Enable built-in schema discovery tools (default: false).
# Registers list_schemas, list_tables_in_schema, get_table_columns,
# get_related_objects, and validate_query. describe_sql_object is always on.
# CLI --builtin-tools wins when both are set.
IBMI_ENABLE_DEFAULT_TOOLS=false

# Enable the execute_sql tool (default: false)
IBMI_ENABLE_EXECUTE_SQL=false

# Control readonly mode for execute_sql tool (default: true)
IBMI_EXECUTE_SQL_READONLY=true

# -----------------------------------------------------------------------------
# HTTP transport / CORS (used when MCP_TRANSPORT_TYPE=http or --transport http)
# -----------------------------------------------------------------------------
# MCP_TRANSPORT_TYPE=http
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=3010
# MCP_HTTP_ENDPOINT_PATH=/mcp

# Comma-separated CORS allowed origins for browser clients.
# - Non-empty list → only those origins
# - Empty + MCP_SERVER_ENV=production → deny all browser origins
# - Empty + non-production (default) → allow any Origin (dev only)
# Example: MCP_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
MCP_ALLOWED_ORIGINS=

# Set to "production" for fail-closed CORS and secret-file checks. See docs/running-on-ibmi.md#secret-file-permissions.
# MCP_SERVER_ENV=production
MCP_SERVER_ENV=
